{
  "functions": {
    "api/scan.js": {
      "maxDuration": 30
    },
    "api/hubs.js": {
      "maxDuration": 15
    },
    "api/tagmatiks.js": {
      "maxDuration": 30
    },
    "api/reference.js": {
      "maxDuration": 30
    },
    "api/prune.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/reference.csv",
      "destination": "/api/reference"
    }
  ],
  "crons": [
    {
      "path": "/api/prune",
      "schedule": "0 10 * * *"
    }
  ]
}
